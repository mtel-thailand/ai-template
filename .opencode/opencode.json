    },
    "be": {
      "temperature": 0.2
    },
    "fe": {
      "temperature": 0.2
    },
    "qa": {
      // "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "devops": {
      // "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "sre": {
      // "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "ai": {},
    "researcher": {
      "temperature": 0.5
    }
  },

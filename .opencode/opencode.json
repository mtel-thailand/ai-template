{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pm",
  "instructions": [
    "AGENTS.md",
    ".opencode/SOUL.md",
    "docs/index.md",
    "docs/architecture.md"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "agent": {
    "pm": {
      "temperature": 0.3
    },
    "po": {
      "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.4
    },
    "sa": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "tech-lead": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "be": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "fe": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "reviewer": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "qa": {
      "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "security": {
      "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.1
    },
    "sre": {
      "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "devops": {
      "model": "anthropic/claude-sonnet-4-haiku",
      "temperature": 0.2
    },
    "ai": {
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "npm run *": "allow",
      "npm test*": "allow",
      "npx *": "allow",
      "git *": "allow",
      "cd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
      "rm src/*": "allow",
      "rm docs/*": "allow",
      "rm *.md": "allow",
      "rm .gitignore": "allow",
      "rm package.json": "allow",
      "rm tsconfig*": "allow",
      "rm -rf node_modules": "allow",
      "rm -rf dist": "allow",
      "rm -rf .next": "allow",
      "rm -rf build": "allow",
      "rmdir *": "deny",
      "cp src/*": "allow",
      "cp docs/*": "allow",
      "cp Dockerfile*": "allow",
      "mv src/*": "allow",
      "mv docs/*": "allow",
      "mv Dockerfile*": "allow",
      "chmod +x *.sh": "allow",
      "chmod 755 *.sh": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "gh_pm": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_PM}",
        "X-MCP-Toolsets": "context,projects,issues,labels,notifications,discussions,users,orgs,pull_requests"
      }
    },
    "gh_design": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_DESIGN}",
        "X-MCP-Toolsets": "context,issues,labels,repos,discussions,git"
      }
    },
    "gh_tech_lead": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_TL}",
        "X-MCP-Toolsets": "context,issues,labels,repos,pull_requests,git"
      }
    },
    "gh_dev": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_DEV}",
        "X-MCP-Toolsets": "context,issues,labels,repos,pull_requests,git,actions,gists"
      }
    },
    "gh_reviewer": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_REVIEW}",
        "X-MCP-Toolsets": "context,issues,labels,repos,pull_requests,git"
      }
    },
    "gh_qa": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_QA}",
        "X-MCP-Toolsets": "context,issues,labels,repos,git,pull_requests,actions"
      }
    },
    "gh_sec": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_SEC}",
        "X-MCP-Toolsets": "context,code_security,secret_protection,security_advisories,dependabot,issues,labels"
      }
    },
    "gh_sre": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_SRE}",
        "X-MCP-Toolsets": "context,issues,labels,repos,git,pull_requests,actions"
      }
    },
    "gh_devops": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_DEVOPS}",
        "X-MCP-Toolsets": "context,actions,repos,git,pull_requests,dependabot,github_support_docs_search"
      }
    },
    "gh_ai": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GH_PAT_AI}",
        "X-MCP-Toolsets": "context,issues,labels,repos,discussions,git"
      }
    }
  }
}

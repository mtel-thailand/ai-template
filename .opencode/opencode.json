{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pm",
  "instructions": [
    "AGENTS.md",
    ".opencode/SOUL.md",
    "docs/index.md",
    "docs/architecture.md"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "agent": {
    "pm": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.3
    },
    "po": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.4
    },
    "tech-lead": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.2
    },
    "be": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git status": "allow",
          "git diff *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git log *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git fetch *": "allow",
          "git rebase *": "allow",
          "git stash *": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git remote add *": "deny",
          "git config --global *": "deny",
          "npm run *": "allow",
          "npm test*": "allow",
          "npx *": "allow",
          "*": "deny"
        }
      }
    },
    "fe": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git status": "allow",
          "git diff *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git log *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git fetch *": "allow",
          "git rebase *": "allow",
          "git stash *": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git remote add *": "deny",
          "git config --global *": "deny",
          "npm run *": "allow",
          "npm test*": "allow",
          "npx *": "allow",
          "*": "deny"
        }
      }
    },
    "reviewer": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1
    },
    "qa": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1
    },
    "security": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1
    },
    "sre": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.2
    },
    "devops": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git push *": "deny",
          "git push --force *": "deny",
          "git remote add *": "deny",
          "git config --global *": "deny",
          "docker *": "allow",
          "git *": "allow",
          "npm run *": "allow",
          "npm test*": "allow",
          "npx *": "allow",
          "*": "deny"
        }
      }
    },
    "ai": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git status": "allow",
          "git diff *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git log *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git fetch *": "allow",
          "git rebase *": "allow",
          "git stash *": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git remote add *": "deny",
          "git config --global *": "deny",
          "*": "deny"
        }
      }
    },
    "researcher": {
      "model": "anthropic/claude-opus-4-7",
      "temperature": 0.5
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "npm run *": "allow",
      "npm test*": "allow",
      "npx *": "allow",
      "git *": "allow",
      "cd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
      "rm src/*": "allow",
      "rm docs/*": "allow",
      "rm *.md": "allow",
      "rm .gitignore": "allow",
      "rm package.json": "allow",
      "rm tsconfig*": "allow",
      "rm -rf node_modules": "allow",
      "rm -rf dist": "allow",
      "rm -rf .next": "allow",
      "rm -rf build": "allow",
      "rmdir *": "deny",
      "cp src/*": "allow",
      "cp docs/*": "allow",
      "cp Dockerfile*": "allow",
      "mv src/*": "allow",
      "mv docs/*": "allow",
      "mv Dockerfile*": "allow",
      "chmod +x *.sh": "allow",
      "chmod 755 *.sh": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "gh_pm": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Toolsets": "context,projects,issues,labels,notifications,discussions,users,orgs,pull_requests"
      }
    },
    "gh_design": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Toolsets": "context,issues,labels,repos,discussions,git"
      }
    },
    "gh_tech_lead": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Toolsets": "context,issues,labels,repos,pull_requests,git"
      }
    },
    "gh_dev": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
